# Copier en .env et adapter. NE JAMAIS committer .env.
APP_NAME=EnerVision API
ENVIRONMENT=development
DEBUG=true

# Connexion PostgreSQL / TimescaleDB (dialecte asyncpg, SQLAlchemy asynchrone).
# Valeur de developpement uniquement : hors du poste local, DATABASE_URL est
# fournie par l'environnement et n'est jamais ecrite dans un fichier suivi.
DATABASE_URL=postgresql+asyncpg://enervision:enervision@db:5432/enervision

# Base des tests d'integration, servie par compose.test.yml sur le port 5433.
# Distincte de la base de developpement : le schema y est reconstruit a chaque
# session de tests.
TEST_DATABASE_URL=postgresql+asyncpg://enervision:enervision@localhost:5433/enervision_test

# Utilisees par le service Postgres du compose
POSTGRES_USER=enervision
POSTGRES_PASSWORD=enervision
POSTGRES_DB=enervision

# Authentification. true (defaut) : les endpoints proteges exigent un JWT
# valide. false : ils passent en anonyme, commode pour du developpement local
# ou pour appeler l'API sans se connecter, mais a ne jamais deployer.
AUTH_ENABLED=true

# Cle de signature des JWT (HS256). VOLONTAIREMENT VIDE ICI : ce fichier est
# versionne. L'API refuse de demarrer si la valeur est absente ou fait moins
# de 32 caracteres. En generer une :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Duree de vie des jetons, en minutes. Courte a dessein : ADR-009 accepte de
# ne pas pouvoir revoquer un jeton avant son expiration.
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# Origines autorisees a appeler l'API depuis un navigateur, separees par des
# virgules. Le dashboard est servi depuis une autre origine : sans cette
# liste, le navigateur bloque toutes ses requetes. JAMAIS de joker, l'API
# refuse de demarrer si elle en trouve un.
# Exemple en developpement : http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Service d'inference (Serving), appele par le job de prediction
# (python -m app.jobs.predict_refresh). L'API fait POST
# {PREDICT_URL}/api/v1/predict : le chemin vient du contrat de predict, seule
# l'adresse se configure. VOLONTAIREMENT VIDE ICI : elle depend de
# l'environnement. Exemple en developpement : http://serving:8000
PREDICT_URL=

# Profondeur demandee a chaque execution, entre 1 et 48 (bornes du contrat).
PREDICT_HORIZON_HOURS=24

# Delai total par site, en secondes.
PREDICT_TIMEOUT_SECONDS=10

# Cle de service presentee au service d'inference, en en-tete X-API-Key.
# Celui-ci relaie la simulation de pic, qui ECRIT sur la source : il exige
# cette cle sur les routes de son contrat depuis qu'il a cesse d'etre ouvert.
#
# Doit valoir exactement le SERVING_API_KEY du service d'inference. Sans elle,
# tous les appels reviennent en 401 : le job de rafraichissement n'archive
# aucune prevision, et le dashboard n'a plus rien a afficher.
#
# Vide est admis, et ne vaut que pour un poste ou le service tourne avec
# SERVING_AUTH_ENABLED=false.
PREDICT_API_KEY=

# --- Seuils des indicateurs de confiance (EV-18) -----------------------------
# Publies dans la reponse a cote de la valeur mesuree : le dashboard les lit
# plutot que de les redeclarer, sans quoi deux verites divergent en silence.

# Age au-dela duquel la derniere mesure d'un site est tenue pour en retard.
# 180 s = collector.lag_warning_s du repo predict, soit trois cadences
# manquees. Les deux valeurs doivent rester alignees.
STALE_THRESHOLD_SECONDS=180

# Part de mesures degradees au-dela de laquelle la fiabilite du site est
# compromise. Meme valeur que le DEGRADED_RATIO des regles de recommandation.
DEGRADED_RATIO_THRESHOLD=0.20

# Rapport tolere entre l'erreur des previsions servies et la consommation
# moyenne du site. Un rapport et non des kilowatts : 20 kW n'ont pas le meme
# sens sur un bureau de 200 kW et sur une usine de 1000.
DRIFT_MAE_RATIO=0.15
