# Copier en .env et adapter. NE JAMAIS committer .env.
APP_NAME=EnerVision API
ENVIRONMENT=development
DEBUG=true

# Connexion PostgreSQL (dialecte psycopg v3)
DATABASE_URL=postgresql+psycopg://enervision:enervision@db:5432/enervision

# Utilisées par le service Postgres du compose
POSTGRES_USER=enervision
POSTGRES_PASSWORD=enervision
POSTGRES_DB=enervision

# Sécurité — générer une vraie valeur : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
